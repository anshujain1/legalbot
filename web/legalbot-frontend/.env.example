# Leave empty to use the built-in mock response (UI works without a backend).
# Set to your LegalBot backend, e.g. http://localhost:8000
# The frontend POSTs { message, history } to {NEXT_PUBLIC_API_URL}/chat
# and reads { raw_answer, sources[], verified, insufficient, warnings[], notes[], disclaimer }.
# Never put an API key here: NEXT_PUBLIC_* values are visible to every visitor.
NEXT_PUBLIC_API_URL=
