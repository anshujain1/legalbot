# Copy to .env and fill in. Never commit .env.

# LLM (answer generation). Search and ingestion work without it.
GROQ_API_KEY=
# LEGALBOT_GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: "sentence-transformers" (default) or "hash" (offline smoke tests only)
# LEGALBOT_EMBEDDER=sentence-transformers
# LEGALBOT_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional cross-encoder reranker, e.g. BAAI/bge-reranker-base
# LEGALBOT_RERANKER=

# Vector store: local on-disk by default, or point at a Qdrant server
# LEGALBOT_QDRANT_PATH=.qdrant
# QDRANT_URL=
# QDRANT_API_KEY=

# HTTP API for a browser frontend (see docs/API.md)
# Exact origins your frontend is served from, comma separated. Defaults cover localhost:3000 / :5173.
# LEGALBOT_CORS_ORIGINS=http://localhost:3000,https://your-site.example
# If set, every route except /health requires header X-API-Key. Call from your server side, never from browser code.
# LEGALBOT_API_KEY=

# Contact put in the scraper's User-Agent (site admins see it)
# LEGALBOT_CONTACT=you@example.com
